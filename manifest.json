{
  "manifest_version": 3,
  "name": "ChatGPT Research Blackboard",
  "version": "0.1.0",
  "description": "A semantic research graph sidecar for ChatGPT with automatic structure, highlights, source jumps, and local export.",
  "default_locale": "en",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    },
    "default_title": "ChatGPT Research Blackboard"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "dist/content.js",
        "dist/research-producer.js",
        "dist/research-selection.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "src/sidepanel/index.html",
        "dist/sidepanel.js",
        "dist/sidepanel.css"
      ],
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]
    }
  ]
}
