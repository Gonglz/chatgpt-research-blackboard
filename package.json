{
  "name": "chatgpt-research-blackboard",
  "version": "0.1.0",
  "description": "A semantic research graph sidecar for ChatGPT with automatic graph maintenance, highlights, source jumps, and export.",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "build:watch": "node build.js --watch",
    "build:release": "node build.js --release",
    "release": "node scripts/release.js",
    "dev": "npm run build:watch",
    "test": "npm run test:graph && npm run test:layout",
    "test:graph": "node scripts/test-graph-delta.mjs",
    "test:layout": "node scripts/test-layout.mjs",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,html}\""
  },
  "keywords": [
    "chatgpt",
    "chrome-extension",
    "research",
    "knowledge-graph",
    "semantic-graph",
    "visualization"
  ],
  "author": "Gonglz",
  "license": "SEE LICENSE IN LICENSE_STATUS.md",
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "dagre": "^0.8.5",
    "elkjs": "0.12.0",
    "html-to-image": "1.11.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "esbuild": "^0.20.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  }
}
